<%- include ('../partials/header') %> 
    <h1>User List</h1>
    <a href="/users/create" class="btn btn-primary">Create New User</a>
    <div class="w-75 m-auto m-5">
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
            <tr>
              <td class="fw-bold"> <%= user.name %> </td>
              <td> <%= user.email %> </td>
              <!-- Actin buttons -->
               <!-- HTML forms only supports GET and POST methods  -->
              <td>
                <a href="/users/edit/<%= user.id %>" class="btn btn-warning" >Edit</a>
                <form action="/users/delete/<%= user.id %>" style="display: inline;" method="post">
                    <button class="btn btn-danger" type="submit">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<%- include ('../partials/footer') %>